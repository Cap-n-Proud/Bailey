# Bailey robot server. Installed by install/install.sh (@USER@ and @REPO@ are filled in).
[Unit]
Description=Bailey robot server (web UI, video, serial link to the Arduino)
After=network-online.target
Wants=network-online.target

[Service]
User=@USER@
WorkingDirectory=@REPO@/server
ExecStart=/usr/bin/node src/server.js
Restart=always
RestartSec=3
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
